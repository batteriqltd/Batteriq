# ============================================================================
# TEMPLATE ONLY — copy to .env.local and fill in real values there.
#
# This file IS COMMITTED TO GIT. Never put a real key in it. Real values
# belong in .env.local (gitignored) and in the Vercel dashboard.
# ============================================================================

# ── SUPABASE ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_me
# Server only — full RLS bypass. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=replace_me

# ── M-PESA / DARAJA ─────────────────────────────────────────────────────────
# MPESA_ENVIRONMENT selects the Safaricom base URL:
#   sandbox    -> https://sandbox.safaricom.co.ke
#   production -> https://api.safaricom.co.ke
MPESA_CONSUMER_KEY=replace_me
MPESA_CONSUMER_SECRET=replace_me
MPESA_BUSINESS_SHORTCODE=replace_me
MPESA_PASSKEY=replace_me
MPESA_ENVIRONMENT=sandbox
# Must be a public HTTPS URL Safaricom can reach — not localhost.
MPESA_CALLBACK_URL=https://<your-domain>/api/mpesa/callback

# ── PESAPAL — Visa / Mastercard card payments (API 3.0) ─────────────────────
# PESAPAL_ENVIRONMENT selects the Pesapal base URL:
#   sandbox -> https://cybqa.pesapal.com/pesapalv3/api
#   live    -> https://pay.pesapal.com/v3/api
PESAPAL_ENVIRONMENT=sandbox
PESAPAL_CONSUMER_KEY=replace_me
PESAPAL_CONSUMER_SECRET=replace_me
# One-time: register https://<your-domain>/api/pesapal/ipn with
# POST /api/pesapal/register-ipn (admin session required), then paste the id.
PESAPAL_IPN_ID=replace_me
# Card processing fee passed on to the customer. 0.02 = 2%.
NEXT_PUBLIC_PESAPAL_CARD_FEE_RATE=0.02

# ── AI ──────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=replace_me

# ── EMAIL (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=replace_me
# Must be a verified sender domain in Resend.
RESEND_FROM_EMAIL=orders@<your-domain>
RESEND_DOMAIN_VERIFIED=true

# ── SITE ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://<your-domain>
NEXT_PUBLIC_SITE_NAME=Batteriq
ADMIN_EMAIL=admin@<your-domain>

# ── WEB PUSH (PWA admin notifications) ──────────────────────────────────────
# Generate a fresh pair with:  node -e "console.log(require('web-push').generateVAPIDKeys())"
# The PUBLIC key is safe to expose to the browser; keep the PRIVATE key secret.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=replace_me
VAPID_PRIVATE_KEY=replace_me
VAPID_SUBJECT=mailto:info@<your-domain>

# ── ADMIN SESSION & DEDICATED OUTREACH ADMIN LOGIN ──────────────────────────
# Random 32+ char secret used to HMAC-sign admin session cookies.
ADMIN_SESSION_SECRET=replace_me
# Dedicated login for the Outreach Agent portal (/outreach-admin/login & /admin/outreach).
# Set real password in Vercel Env Vars & local .env.local (never commit passwords to git).
OUTREACH_ADMIN_EMAIL=sale@batteriq.com
OUTREACH_ADMIN_PASSWORD=replace_me

# ── OUTREACH AGENT — OPTIONAL 2ND DEDICATED SUPABASE PROJECT ────────────────
# Use these if you want the Outreach Agent to run on its own separate Supabase
# database without touching the main store Supabase project.
# (If omitted, Outreach Agent automatically falls back to NEXT_PUBLIC_SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY)
OUTREACH_SUPABASE_URL=https://<your-outreach-project-ref>.supabase.co
OUTREACH_SUPABASE_SERVICE_ROLE_KEY=replace_me

# ── OUTREACH AGENT — CLAUDE AI, GOOGLE PLACES, CRON & UNSUBSCRIBE ───────────
ANTHROPIC_API_KEY=replace_me
ANTHROPIC_MODEL=claude-sonnet-4-6
GOOGLE_PLACES_API_KEY=replace_me
# Verified Resend sender for B2B outreach (falls back to RESEND_FROM_EMAIL if omitted)
RESEND_OUTREACH_FROM_EMAIL=sales@batteriq.com
OUTREACH_REPLY_TO_EMAIL=sale@batteriq.com
# Random 32+ char secret Vercel sends automatically as Authorization: Bearer <CRON_SECRET>
CRON_SECRET=replace_me
# Random 32+ char secret used to HMAC-sign one-click unsubscribe links
OUTREACH_UNSUBSCRIBE_SECRET=replace_me

# ── WHATSAPP CLOUD API (META BUSINESS PLATFORM) ─────────────────────────────
WHATSAPP_ACCESS_TOKEN=replace_me
WHATSAPP_PHONE_NUMBER_ID=replace_me
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace_me
# Optional/recommended: Meta App Secret to verify X-Hub-Signature-256 on incoming webhooks
WHATSAPP_APP_SECRET=replace_me
WHATSAPP_API_VERSION=v21.0

# ── AFRICA'S TALKING VOICE (PHASE 2 STUB) ───────────────────────────────────
AFRICASTALKING_API_KEY=replace_me
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_CALLER_ID=+254711082000
OUTREACH_HUMAN_TRANSFER_PHONE=+254716822014
