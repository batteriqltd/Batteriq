{
  "id": "/outreach-admin",
  "name": "BatterIQ Console",
  "short_name": "BatterIQ",
  "description": "BatterIQ's outreach console — live leads, quotes, WhatsApp and email pipeline with instant push alerts.",
  "start_url": "/outreach-admin",
  "scope": "/outreach-admin/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#00004d",
  "theme_color": "#00004d",
  "lang": "en",
  "dir": "ltr",
  "prefer_related_applications": false,
  "categories": ["business", "productivity"],
  "icons": [
    {
      "src": "/outreach-icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/outreach-icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/outreach-icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/outreach-icons/icon-maskable-1024.png",
      "sizes": "1024x1024",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Client Directory",
      "short_name": "Clients",
      "url": "/outreach-admin#leads",
      "icons": [{ "src": "/outreach-icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "WhatsApp Inbox",
      "short_name": "Inbox",
      "url": "/outreach-admin#whatsapp",
      "icons": [{ "src": "/outreach-icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
