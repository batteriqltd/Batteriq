{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "functions": {
    "app/api/mpesa/callback/route.ts": {
      "maxDuration": 30
    },
    "app/api/ai/chat/route.ts": {
      "maxDuration": 60
    },
    "app/api/mpesa/stkpush/route.ts": {
      "maxDuration": 30
    },
    "app/api/pesapal/checkout/route.ts": {
      "maxDuration": 30
    },
    "app/api/pesapal/ipn/route.ts": {
      "maxDuration": 30
    },
    "app/api/pesapal/reconcile/route.ts": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/api/mpesa/callback",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/api/pesapal/ipn",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}