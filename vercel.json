{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "functions": {
    "app/api/mpesa/callback/route.ts": {
      "maxDuration": 30
    },
    "app/api/mpesa/stkpush/route.ts": {
      "maxDuration": 30
    },
    "app/api/pesapal/checkout/route.ts": {
      "maxDuration": 30
    },
    "app/api/pesapal/ipn/route.ts": {
      "maxDuration": 30
    },
    "app/api/pesapal/reconcile/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/outreach-leads/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/outreach-emails/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/outreach-followups/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/outreach-autopilot/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/outreach-whatsapp/route.ts": {
      "maxDuration": 60
    },
    "app/api/admin/outreach/proforma/route.ts": {
      "maxDuration": 60
    },
    "app/api/whatsapp/webhook/route.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/outreach-leads",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/outreach-emails",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/outreach-followups",
      "schedule": "30 7 * * *"
    },
    {
      "path": "/api/cron/outreach-autopilot",
      "schedule": "15 5 * * *"
    },
    {
      "path": "/api/cron/outreach-whatsapp",
      "schedule": "45 8 * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/mpesa/callback",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/api/pesapal/ipn",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/api/whatsapp/webhook",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
